# Xingyu Pay · BaoTa production environment template
# Copy to /www/wwwroot/xingyu-pay-backend/.env and chmod 600.

SERVER_PORT=8889
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=prod
JAVA_HOME=/www/server/java/jdk1.8.0_371
JVM_HEAP_SIZE='-Xms256m -Xmx512m'

SITE_URL=https://pay.example.com
FRONTEND_DIR=/www/wwwroot/pay.example.com
QR_DIR=/www/wwwroot/xingyu-pay-backend/qr

DB_URL='jdbc:mysql://127.0.0.1:3306/pay?useSSL=false&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true'
DB_USERNAME=pay
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=1

ADMIN_TOKEN=CHANGE_ME_64_HEX
OPENAPI_SECRET=CHANGE_ME_64_HEX
ADMIN_TOKEN_EXPIRE_DAYS=14
ORDER_TIMEOUT_MINUTES=30

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
MAIL_AUTH=true
MAIL_STARTTLS=false
MAIL_SSL_ENABLE=true
MAIL_SSL_TRUST=smtp.qq.com
MAIL_FROM=you@example.com
MAIL_TO=you@example.com
SUPPORT_MAIL=you@example.com

SITE_TITLE=星屿支付
INDEX_TITLE=星屿支付
PAYEE_NAME=Your Name
EMAIL_BRAND_NAME=星屿支付
PAYEE_MOBILE=10000000000
ALIPAY_USER_ID=
ALIPAY_CUSTOM_QR_URL=
