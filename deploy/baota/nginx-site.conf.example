server {
    listen 80;
    server_name pay.example.com;
    server_tokens off;
    root /www/wwwroot/pay.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/pay.example.com;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name pay.example.com;
    server_tokens off;
    root /www/wwwroot/pay.example.com;

    # 宝塔 SSL 页面申请证书后，使用面板显示的实际路径
    ssl_certificate     /www/server/panel/vhost/cert/pay.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/pay.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 2m;
    client_body_timeout 15s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # 宝塔站点根目录只放前端资源；后端目录不在这里。
    location ~* (^|/)(\.env|\.git|\.svn|target|logs?|data)(/|$) {
        return 404;
    }
    location ~* \.(env|jar|class|war|log|pid|sql|bak|old|tmp|pem|key|p12|jks)$ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8889;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
