[Unit]
Description=Xingyu Pay backend service
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/xingyu-pay/backend
EnvironmentFile=/opt/xingyu-pay/backend/.env
ExecStart=/opt/xingyu-pay/backend/start.sh
Restart=always
RestartSec=5
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=-/opt/xingyu-pay/backend/logs -/opt/xingyu-pay/backend/qr
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

